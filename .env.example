# OpenRouter API Configuration (supports z-ai/glm-4.7-flash, google/gemini-2.5-flash-lite, deepseek/deepseek-v4.1-flash)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.7-flash

# Fallback Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated origins. Use * only behind another reverse proxy you control.
CORS_ORIGINS=*

RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_CHARS=2000
LOG_LEVEL=INFO

# When local retrieval is weak, optionally query DuckDuckGo Instant Answer (external).
ALLOW_WEB_FALLBACK=false

# ==============================================================================
# Automated Updates & Continuous Deployment Configuration
# ==============================================================================
# Background sync interval in hours (checks GitHub releases for olake, olake-fusion, olake-helm, olake-ui)
# Set to 0 to disable periodic background polling and rely on webhooks/deployments.
AUTO_SYNC_HOURS=12

# Optional secret bearer token required to call POST /api/sync webhook from CI/CD pipelines
# Example: curl -X POST https://your-domain.com/api/sync -H "Authorization: Bearer my-secret"
SYNC_SECRET=

# Optional GitHub Token to increase rate limits (from 60/hr to 5000/hr) when syncing releases
GITHUB_TOKEN=

# Directory overrides for custom doc mounts or container runtime writes
# KNOWLEDGE_DIR=./knowledge
# RUNTIME_KNOWLEDGE_DIR=/tmp/olake_knowledge

# Content Security Policy frame-ancestors (allows embedding widget on docs sites)
FRAME_ANCESTORS=*

